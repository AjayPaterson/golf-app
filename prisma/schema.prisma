// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id String @id @default(uuid())
  first_name String
  last_name String
  handicap_index Float?
  user_id String? @unique

  registrations Registration[]
  scores Score[]
  pairings Pairing[]
  user User? @relation(fields: [user_id], references: [id])
}

model Course {
  id String @id @default(uuid())
  name String
  location String

  rounds Round[]
  holes Hole[]
  tees Tee[]
}

model Tee {
  id  String @id @default(uuid())
  course_id String
  name  String  // "red", "white", "blue", etc.
  yardage Int
  course_rating Float
  slope_rating  Float

  course Course @relation(fields: [course_id], references: [id])
  pairings Pairing[]
}

model Round {
  id String @id @default(uuid())
  event_id String
  course_id String
  round_number Int
  date DateTime

  event Event @relation(fields: [event_id], references: [id])
  course Course @relation(fields: [course_id], references: [id])

  carts Cart[] 
  pairings Pairing []
}

model Team {
  id String @id @default(uuid())
  name String?
  event_id String
  adjusted_handicap Int

  event Event @relation(fields: [event_id], references: [id])

  registrations Registration[]
}

model Pairing {
  id String @id @default(uuid())
  round_id String
  cart_id String
  player_id String
  tee_id  String?  

  round Round @relation(fields: [round_id], references: [id])
  cart Cart @relation(fields: [cart_id], references: [id])
  player Player @relation(fields: [player_id], references: [id])
  tee Tee? @relation(fields: [tee_id], references: [id])
}

model Cart {
  id String @id @default(uuid())
  round_id String
  cart_name String
  access_token String @unique
  tee_time String?

  round Round @relation(fields: [round_id], references: [id])

  scores Score []
  pairings Pairing[]
}

model Score {
  id String @id @default(uuid())
  player_id String
  cart_id String
  hole_number Int
  strokes Int

  player Player @relation(fields: [player_id], references: [id])
  cart Cart @relation(fields: [cart_id], references: [id])

  @@unique([player_id, hole_number, cart_id])
}

model Hole {
  id            String @id @default(uuid())
  course_id     String
  hole_number   Int
  par           Int
  handicap_rating Int

  course Course @relation(fields: [course_id], references: [id])
}

enum EventType {
	casual
	challenge
	league
	tournament
}

model Event{
	id 	String	@id @default(uuid())
	type  EventType
	name  String 
	start_date DateTime
	end_date DateTime
  play_format PlayFormat
	
	rounds  Round[]
	tournament_details TournamentDetails?
  registrations Registration[]
  teams Team[]
  event_organizer EventOrganizer[]
}

model TournamentDetails {	
	id String	@id	@default(uuid())
	number_of_rounds	Int
	year	Int

	event_id	String	@unique
	event	Event @relation(fields: [event_id], references: [id])
}

model Registration {
	id	String	@id	@default(uuid())
	player_id	String
	event_id	String
	team_id String?
	
	player Player	@relation(fields: [player_id], references: [id])
	event Event	@relation(fields: [event_id], references: [id])
	team Team?	@relation(fields: [team_id], references: [id])
	
	registration_details RegistrationDetails?
  casual_registration_details CasualRegistrationDetails?
}

model RegistrationDetails {
	id	String	@id	@default(uuid())
	full_handicap	Int
	three_quarter_handicap	Int
	adjusted_handicap	Int
	registration_id	String	@unique

	registration Registration	@relation(fields: [registration_id], references: [id])
}

model EventOrganizer {
  id String @id @default(uuid())
  primary_organizer Boolean @default(true)
  user_id String
  event_id String

  user User @relation(fields: [user_id], references: [id])
  event Event @relation(fields: [event_id], references: [id])
}

enum ModeType {
	light
  dark
}

model User {
  id String @id 
  is_admin Boolean @default(false)
  display_name String?
  mode_type ModeType @default(light)

  event_organizer EventOrganizer[]
  player Player?
}

enum PlayFormat {
  stroke_play
  match_play
  best_ball
  scramble
  stableford
}

model CasualRegistrationDetails {
  id  String @id  @default(uuid())
  play_format PlayFormat
  stroke_allowance  Int?
  registration_id String @unique
  

  registration Registration @relation(fields: [registration_id], references: [id])
}